# ─────────────────────────────────────────────────────────────
# Ask the Alert – Backend Environment Variables
# Copy to .env and fill in real values. Never commit .env.
# ─────────────────────────────────────────────────────────────

# Server
PORT=3001
NODE_ENV=development

# Supabase Postgres
# Project URL and service-role key (bypasses RLS for backend operations)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# APNs (Apple Push Notification service)
# Authentication: token-based (recommended for 2026)
APNS_KEY_PATH=./certs/APNsAuthKey_XXXXXXXXXX.p8
APNS_KEY_ID=XXXXXXXXXX
APNS_TEAM_ID=XXXXXXXXXX
APNS_BUNDLE_ID=com.yourcompany.yourapp
# "development" | "production" — must match the iOS build
APNS_ENVIRONMENT=development

# Authority Console auth (shared secret for demo)
# Used as Bearer token for protected endpoints
# SSE stream uses this as ?token= query parameter
# Must match exactly what you type on the console login screen.
# SECURITY: Generate a long random secret (e.g., openssl rand -hex 32)
CONSOLE_AUTH_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET_MINIMUM_32_CHARS
